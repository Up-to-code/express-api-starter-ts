# =============================================================================
# إتجاه العقارية (Etjahh Real Estate) - Backend Configuration Example
# =============================================================================
# This file contains all environment variables for the real estate management system
# Copy this file to .env and update the values for your environment
# =============================================================================

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL database connection string
# Format: postgresql://username:password@host:port/database_name?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/boot_db?schema=public"

# Database connection pool settings (optional)
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
# Port for the backend server to run on
PORT=5000

# Environment mode (development, production, test)
NODE_ENV=development

# CORS allowed origins (comma-separated for multiple origins)
CORS_ORIGINS="http://localhost:3000,https://yourdomain.com"

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================
# JWT secret key for token signing (MUST be changed in production)
# Generate a strong random key: openssl rand -base64 64
JWT_SECRET="your-super-secret-jwt-key-here-make-it-long-and-random"

# NextAuth configuration (if using NextAuth)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-key-here"

# JWT token expiration time
JWT_EXPIRES_IN="7d"

# Password hashing rounds (higher = more secure but slower)
BCRYPT_ROUNDS=12

# =============================================================================
# OPENAI / CHATGPT CONFIGURATION
# =============================================================================
# OpenAI API key for AI-powered real estate assistant
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-proj-your-openai-api-key-here"

# OpenAI model to use (gpt-3.5-turbo, gpt-4, etc.)
OPENAI_MODEL="gpt-3.5-turbo"

# OpenAI API base URL (usually default)
OPENAI_API_URL="https://api.openai.com/v1"

# Maximum tokens for OpenAI responses
OPENAI_MAX_TOKENS=500

# OpenAI temperature (0.0 to 1.0, higher = more creative)
OPENAI_TEMPERATURE=0.7

# =============================================================================
# WHATSAPP BUSINESS API CONFIGURATION
# =============================================================================
# WhatsApp Business API access token
# Get from: https://developers.facebook.com/apps/
WHATSAPP_ACCESS_TOKEN="your-whatsapp-access-token"

# WhatsApp Phone Number ID (from WhatsApp Business API)
WHATSAPP_PHONE_NUMBER_ID="your-phone-number-id"

# WhatsApp webhook verify token (set this to any secure string)
WHATSAPP_VERIFY_TOKEN="your-webhook-verify-token"

# WhatsApp API URL for sending messages
WHATSAPP_API_URL="https://graph.facebook.com/v18.0/YOUR_PHONE_NUMBER_ID/messages"

# WhatsApp webhook URL (for receiving messages)
WEBHOOK_URL="https://yourdomain.com/api/whatsapp/webhook"

# =============================================================================
# UPLOADTHING CONFIGURATION (File Upload Service)
# =============================================================================
# UploadThing secret key for file uploads
# Get from: https://uploadthing.com/dashboard
UPLOADTHING_SECRET="sk_live_your-uploadthing-secret"

# UploadThing App ID
UPLOADTHING_APP_ID="your-uploadthing-app-id"

# UploadThing token (base64 encoded credentials)
UPLOADTHING_TOKEN="your-uploadthing-token"

# UploadThing API URL (usually default)
UPLOADTHING_API_URL="https://uploadthing.com/api"

# Maximum file size for uploads (in MB)
UPLOADTHING_MAX_FILE_SIZE=10

# =============================================================================
# EMAIL CONFIGURATION (Optional)
# =============================================================================
# SMTP settings for sending emails (appointment confirmations, etc.)
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-app-password"
EMAIL_FROM="إتجاه العقارية <noreply@etjahh.com>"

# Email templates directory
EMAIL_TEMPLATES_DIR="./templates/emails"

# =============================================================================
# SMS CONFIGURATION (Optional)
# =============================================================================
# SMS service for sending appointment reminders
SMS_PROVIDER="twilio"
SMS_ACCOUNT_SID="your-twilio-account-sid"
SMS_AUTH_TOKEN="your-twilio-auth-token"
SMS_FROM_NUMBER="+1234567890"

# =============================================================================
# REDIS CONFIGURATION (Optional - for caching)
# =============================================================================
# Redis connection for caching and session storage
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD="your-redis-password"
REDIS_DB=0

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
# Log level (error, warn, info, debug)
LOG_LEVEL="info"

# Log file path (optional)
LOG_FILE="logs/app.log"

# Enable console logging
LOG_CONSOLE=true

# =============================================================================
# RATE LIMITING CONFIGURATION
# =============================================================================
# API rate limiting settings
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# WhatsApp rate limiting (messages per minute)
WHATSAPP_RATE_LIMIT=60

# =============================================================================
# GOOGLE MAPS CONFIGURATION (Optional)
# =============================================================================
# Google Maps API key for location services
GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# Default map center coordinates (Riyadh, Saudi Arabia)
DEFAULT_MAP_LAT=24.7136
DEFAULT_MAP_LNG=46.6753

# =============================================================================
# PAYMENT GATEWAY CONFIGURATION (Optional)
# =============================================================================
# Payment processing for property transactions
STRIPE_SECRET_KEY="sk_test_your-stripe-secret-key"
STRIPE_PUBLISHABLE_KEY="pk_test_your-stripe-publishable-key"
STRIPE_WEBHOOK_SECRET="whsec_your-stripe-webhook-secret"

# PayPal configuration (alternative)
PAYPAL_CLIENT_ID="your-paypal-client-id"
PAYPAL_CLIENT_SECRET="your-paypal-client-secret"
PAYPAL_MODE="sandbox"

# =============================================================================
# BACKUP CONFIGURATION (Optional)
# =============================================================================
# Database backup settings
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_PATH="/backups"

# Cloud backup settings
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_REGION="us-east-1"
AWS_S3_BUCKET="your-backup-bucket"

# =============================================================================
# MONITORING & ANALYTICS (Optional)
# =============================================================================
# Application monitoring and analytics
SENTRY_DSN="your-sentry-dsn"
GOOGLE_ANALYTICS_ID="GA-XXXXXXXXX"

# Performance monitoring
NEW_RELIC_LICENSE_KEY="your-newrelic-license-key"
NEW_RELIC_APP_NAME="Etjahh Real Estate API"

# =============================================================================
# SOCIAL MEDIA INTEGRATION (Optional)
# =============================================================================
# Social media API keys for property sharing
FACEBOOK_APP_ID="your-facebook-app-id"
FACEBOOK_APP_SECRET="your-facebook-app-secret"
TWITTER_API_KEY="your-twitter-api-key"
TWITTER_API_SECRET="your-twitter-api-secret"
INSTAGRAM_ACCESS_TOKEN="your-instagram-access-token"

# =============================================================================
# DEVELOPMENT TOOLS (Development Only)
# =============================================================================
# Enable debug mode (development only)
DEBUG_MODE=true

# Enable API documentation (development only)
ENABLE_API_DOCS=true

# Seed database on startup (development only)
SEED_DATABASE=false

# Enable hot reload (development only)
HOT_RELOAD=true

# =============================================================================
# PRODUCTION SETTINGS (Production Only)
# =============================================================================
# SSL/TLS settings for production
SSL_CERT_PATH="/path/to/ssl/cert.pem"
SSL_KEY_PATH="/path/to/ssl/private.key"

# Production domain
PRODUCTION_DOMAIN="https://api.etjahh.com"

# Enable HTTPS redirect
FORCE_HTTPS=true

# Security headers
ENABLE_SECURITY_HEADERS=true

# =============================================================================
# COMPANY INFORMATION
# =============================================================================
# Company details for branding and legal
COMPANY_NAME_AR="شركة إتجاه العقارية"
COMPANY_NAME_EN="Etjahh Real Estate Company"
COMPANY_PHONE="+966123456789"
COMPANY_EMAIL="info@etjahh.com"
COMPANY_WEBSITE="https://etjahh.com"
COMPANY_ADDRESS_AR="الرياض، المملكة العربية السعودية"
COMPANY_ADDRESS_EN="Riyadh, Saudi Arabia"

# Business hours
BUSINESS_HOURS_START="09:00"
BUSINESS_HOURS_END="18:00"
BUSINESS_DAYS="sunday,monday,tuesday,wednesday,thursday"

# =============================================================================
# API VERSIONING & DOCUMENTATION
# =============================================================================
# API version
API_VERSION="v1"

# API documentation URL
API_DOCS_URL="/api/docs"

# Enable API versioning
ENABLE_API_VERSIONING=true

# =============================================================================
# FEATURE FLAGS (Optional)
# =============================================================================
# Enable/disable specific features
ENABLE_AI_ASSISTANT=true
ENABLE_PROPERTY_SEARCH=true
ENABLE_APPOINTMENT_BOOKING=true
ENABLE_IMAGE_UPLOAD=true
ENABLE_WHATSAPP_INTEGRATION=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_SMS_NOTIFICATIONS=false

# =============================================================================
# LOCALIZATION
# =============================================================================
# Default language
DEFAULT_LANGUAGE="ar"

# Supported languages (comma-separated)
SUPPORTED_LANGUAGES="ar,en"

# Timezone
TIMEZONE="Asia/Riyadh"

# Currency
DEFAULT_CURRENCY="SAR"

# =============================================================================
# END OF CONFIGURATION
# =============================================================================
# Remember to:
# 1. Copy this file to .env and update the values
# 2. Never commit .env file with real credentials to version control
# 3. Use different values for development, staging, and production
# 4. Regularly rotate API keys and secrets
# 5. Keep backups of your configuration in a secure location
# =============================================================================
